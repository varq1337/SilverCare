DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development
# Demo verification code; replace with a real SMS provider later
TEST_CODE=1234
SESSION_DAYS=30
# Minutes after the scheduled time (or postponed time) before a dose counts as missed
MISSED_AFTER_MINUTES=60
# Set to "false" to disable node-cron reminders
SCHEDULER_ENABLED=true
# Allowed browser origin for the frontend if it is served from another origin (optional)
CORS_ORIGIN=
