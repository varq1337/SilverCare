<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  body { margin: 0; background: #ECECEF; font-family: -apple-system, 'SF Pro Display', 'Plus Jakarta Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: #0A64D6; }
  a:hover { color: #08489B; }
  @keyframes scDot { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.82); } }
  @keyframes scGlow { 0%,100% { box-shadow: 0 10px 30px rgba(255,59,48,0.18); } 50% { box-shadow: 0 14px 44px rgba(255,59,48,0.34); } }
  ::-webkit-scrollbar { width: 0; height: 0; }
  input { font-family: inherit; }
  input::placeholder { color: #9A9AA0; }
</style>
</helmet>
<div style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 36px 16px 56px;">

  <div style="width: 390px; height: 844px; max-width: 100%; background: #F2F2F7; border-radius: 54px; border: 9px solid #101012; box-shadow: 0 40px 90px rgba(16,16,18,0.32), 0 4px 12px rgba(16,16,18,0.18); overflow: hidden; display: flex; flex-direction: column; position: relative;">

    <div style="height: 50px; flex: none; display: flex; align-items: center; justify-content: space-between; padding: 0 30px; font-size: 15px; font-weight: 600; color: #101012; letter-spacing: -0.2px;">
      <span>{{ clockText }}</span>
      <span style="display: flex; align-items: center; gap: 6px; font-size: 13px; letter-spacing: 1px;">▁▃▅ ⌁ ▮</span>
    </div>

    <sc-if value="{{ isToday }}" hint-placeholder-val="{{ true }}">
      <div style="flex: none; padding: 6px 22px 16px; display: flex; flex-direction: column; gap: 3px;">
        <div style="font-size: 36px; font-weight: 800; color: #101012; letter-spacing: -1.2px; line-height: 1.05;">Сегодня</div>
        <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">{{ dateText }} · принято {{ takenCount }} из {{ totalCount }}</div>
      </div>

      <sc-if value="{{ isDue }}" hint-placeholder-val="{{ true }}">
        <div style="margin: 0 18px; padding: 22px 22px 24px; border-radius: 30px; background: #FFFFFF; display: flex; flex-direction: column; gap: 4px; animation: scGlow 2.4s ease-in-out infinite;">
          <div style="display: flex; align-items: center; gap: 9px; margin-bottom: 4px;">
            <span style="width: 11px; height: 11px; border-radius: 50%; background: #FF3B30; display: inline-block; animation: scDot 1.2s ease-in-out infinite;"></span>
            <span style="font-size: 14px; font-weight: 700; letter-spacing: 1.4px; color: #D32D22;">ПОРА ПРИНЯТЬ</span>
          </div>
          <div style="font-size: 34px; font-weight: 800; color: #101012; line-height: 1.1; letter-spacing: -1.2px; overflow-wrap: anywhere; word-break: break-word;">{{ dueName }}</div>
          <div style="font-size: 22px; font-weight: 500; color: #101012; letter-spacing: -0.4px; overflow-wrap: anywhere; word-break: break-word;">{{ dueDose }}</div>
          <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">{{ dueNote }} · назначено на {{ dueTime }}</div>
        </div>

        <div style="margin: 14px 18px 0; display: flex; flex-direction: column; gap: 10px;">
          <button onClick="{{ onTake }}" style="width: 100%; min-height: 88px; border: none; border-radius: 26px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 27px; font-weight: 700; letter-spacing: -0.5px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; box-shadow: 0 12px 28px rgba(10,132,255,0.32); transition: transform 0.12s ease;" style-active="transform: scale(0.975);">
            <span style="font-size: 28px;">✓</span> Я принял
          </button>
          <div style="display: flex; gap: 10px;">
            <button onClick="{{ onSnooze }}" style="width: 100%; min-height: 60px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 17px; font-weight: 600; letter-spacing: -0.2px; cursor: pointer;" style-active="background: #EFEFF2;">Через 15 мин</button>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isWaiting }}" hint-placeholder-val="{{ false }}">
        <div style="margin: 0 18px; padding: 24px 22px; border-radius: 30px; background: #FFFFFF; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 8px 26px rgba(16,16,18,0.06);">
          <div style="font-size: 13px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F;">СЛЕДУЮЩИЙ ПРИЁМ</div>
          <div style="font-size: 58px; font-weight: 800; color: #101012; line-height: 1.05; letter-spacing: -2.6px; font-variant-numeric: tabular-nums;">{{ nextTime }}</div>
          <div style="font-size: 24px; font-weight: 600; color: #101012; letter-spacing: -0.5px; overflow-wrap: anywhere; word-break: break-word;">{{ nextName }}</div>
          <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">{{ nextDose }} · {{ countdownText }}</div>
        </div>
        <div style="margin: 12px 18px 0; padding: 16px 20px; border-radius: 22px; background: #E6F0FE; color: #0A4EA8; font-size: 17px; font-weight: 500; line-height: 1.35; letter-spacing: -0.2px;">
          Телефон напомнит сам, когда придёт время. Ничего нажимать не нужно.
        </div>
      </sc-if>

      <sc-if value="{{ isDone }}" hint-placeholder-val="{{ false }}">
        <div style="margin: 0 18px; padding: 28px 22px; border-radius: 30px; background: #FFFFFF; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 8px 26px rgba(16,16,18,0.06);">
          <div style="width: 54px; height: 54px; border-radius: 50%; background: #E4F5E9; color: #1B7A3E; font-size: 28px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 6px;">✓</div>
          <div style="font-size: 29px; font-weight: 700; color: #101012; line-height: 1.15; letter-spacing: -0.9px;">{{ doneTitle }}</div>
          <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">{{ doneSubtitle }}</div>
        </div>
      </sc-if>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 20px 18px 6px; display: flex; flex-direction: column; gap: 7px;">
        <div style="font-size: 13px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F; padding-left: 4px;">РАСПИСАНИЕ ДНЯ</div>
        <sc-for list="{{ doses }}" as="d" hint-placeholder-count="4">
          <div style="display: flex; flex-direction: column; gap: 1px; padding: 12px 16px; border-radius: 20px; background: #FFFFFF;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
              <div style="font-size: 20px; font-weight: 700; color: #101012; letter-spacing: -0.5px; font-variant-numeric: tabular-nums;">{{ d.time }}</div>
              <div style="flex: none; white-space: nowrap; font-size: 13px; font-weight: 700; letter-spacing: 0.3px; padding: 4px 11px; border-radius: 999px; color: {{ d.fg }}; background: {{ d.bg }};">{{ d.status }}</div>
            </div>
            <div style="font-size: 18px; font-weight: 600; color: #101012; letter-spacing: -0.3px; overflow-wrap: anywhere; word-break: break-word;">{{ d.name }}</div>
            <div style="font-size: 16px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px; overflow-wrap: anywhere; word-break: break-word;">{{ d.dose }}</div>
          </div>
        </sc-for>
      </div>

      <div style="flex: none; padding: 10px 18px 20px; display: flex; flex-direction: column; gap: 9px;">
        <button onClick="{{ onSos }}" style="width: 100%; min-height: 74px; border: none; border-radius: 24px; background: #E5322A; color: #FFFFFF; font-family: inherit; font-size: 23px; font-weight: 800; letter-spacing: -0.4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; box-shadow: 0 12px 28px rgba(229,50,42,0.34); transition: transform 0.12s ease;" style-active="transform: scale(0.98);">
          <span style="width: 13px; height: 13px; border-radius: 50%; background: #FFFFFF; display: inline-block;"></span> Мне нужна помощь
        </button>
        <button onClick="{{ onOpenContacts }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Близкие контакты</button>
        <button onClick="{{ onOpenList }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Мои лекарства</button>
        <button onClick="{{ onOpenBrain }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07); display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 0 20px;" style-active="background: #EFEFF2;">
          <span>Тренировка памяти</span>
          <span style="flex: none; white-space: nowrap; font-size: 14px; font-weight: 700; letter-spacing: 0.2px; padding: 5px 11px; border-radius: 999px; color: {{ brainBadgeFg }}; background: {{ brainBadgeBg }};">{{ brainBadge }}</span>
        </button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 3px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isBrain }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 14px; display: flex; flex-direction: column; gap: 3px;">
        <div style="font-size: 34px; font-weight: 800; color: #101012; letter-spacing: -1.2px; line-height: 1.05;">Тренировка памяти</div>
        <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">5 минут в день — и вспоминать легче</div>
      </div>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 18px 8px; display: flex; flex-direction: column; gap: 12px;">
        <div style="display: flex; gap: 10px;">
          <div style="flex: 1; min-width: 0; padding: 18px 16px; border-radius: 22px; background: #FFFFFF; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 4px 14px rgba(16,16,18,0.05);">
            <div style="font-size: 40px; font-weight: 800; color: #101012; letter-spacing: -1.6px; line-height: 1;">{{ brainStreak }}</div>
            <div style="font-size: 15px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">дней подряд</div>
          </div>
          <div style="flex: 1; min-width: 0; padding: 18px 16px; border-radius: 22px; background: #FFFFFF; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 4px 14px rgba(16,16,18,0.05);">
            <div style="font-size: 40px; font-weight: 800; color: #101012; letter-spacing: -1.6px; line-height: 1;">{{ brainLast }}</div>
            <div style="font-size: 15px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">прошлый результат</div>
          </div>
        </div>

        <div style="padding: 22px 20px; border-radius: 26px; background: #FFFFFF; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 8px 26px rgba(16,16,18,0.06);">
          <div style="font-size: 13px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F;">СЕГОДНЯШНЕЕ УПРАЖНЕНИЕ</div>
          <div style="font-size: 27px; font-weight: 700; color: #101012; letter-spacing: -0.8px; line-height: 1.15;">Запомните четыре слова</div>
          <div style="font-size: 18px; font-weight: 500; color: #6E6E73; line-height: 1.4; letter-spacing: -0.2px;">Слова покажутся на несколько секунд. Потом нужно узнать их среди других. Три вопроса — и всё.</div>
        </div>

        <div style="padding: 16px 20px; border-radius: 20px; background: #E6F0FE; color: #0A4EA8; font-size: 16px; font-weight: 500; line-height: 1.4; letter-spacing: -0.2px;">
          Ошибиться не страшно. Здесь нет оценок — только тренировка.
        </div>
      </div>

      <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
        <button onClick="{{ onBrainStart }}" style="width: 100%; min-height: 80px; border: none; border-radius: 26px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 24px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; box-shadow: 0 12px 28px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">Начать</button>
        <button onClick="{{ onBack }}" style="width: 100%; min-height: 62px; border: none; border-radius: 22px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Назад к расписанию</button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 4px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isBrainPlay }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 14px; display: flex; flex-direction: column; gap: 4px;">
        <div style="font-size: 13px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F;">{{ brainStepLabel }}</div>
        <div style="font-size: 30px; font-weight: 800; color: #101012; letter-spacing: -1px; line-height: 1.1;">{{ brainTitle }}</div>
      </div>

      <sc-if value="{{ brainShowing }}" hint-placeholder-val="{{ false }}">
        <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 18px; display: flex; flex-direction: column; gap: 10px; justify-content: center;">
          <sc-for list="{{ brainWords }}" as="w" hint-placeholder-count="4">
            <div style="padding: 20px 22px; border-radius: 22px; background: #FFFFFF; font-size: 30px; font-weight: 700; color: #101012; letter-spacing: -0.8px; text-align: center; box-shadow: 0 6px 20px rgba(16,16,18,0.06); overflow-wrap: anywhere;">{{ w.label }}</div>
          </sc-for>
        </div>
        <div style="flex: none; padding: 16px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
          <div style="height: 10px; border-radius: 999px; background: #E2E2E8; overflow: hidden;">
            <div style="height: 100%; border-radius: 999px; background: #0A84FF; width: {{ brainProgress }};"></div>
          </div>
          <div style="text-align: center; font-size: 19px; font-weight: 600; color: #6E6E73; letter-spacing: -0.3px;">{{ brainCountdown }}</div>
          <button onClick="{{ onBrainReady }}" style="width: 100%; min-height: 66px; border: none; border-radius: 22px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Я запомнил</button>
          <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 2px auto 0;"></div>
        </div>
      </sc-if>

      <sc-if value="{{ brainAsking }}" hint-placeholder-val="{{ false }}">
        <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 18px 8px; display: flex; flex-direction: column; gap: 10px; justify-content: center;">
          <sc-for list="{{ brainOptions }}" as="o" hint-placeholder-count="4">
            <button onClick="{{ o.onPick }}" style="width: 100%; min-height: 76px; border: none; border-radius: 22px; font-family: inherit; font-size: 26px; font-weight: 700; letter-spacing: -0.6px; cursor: pointer; padding: 14px 20px; overflow-wrap: anywhere; color: {{ o.fg }}; background: {{ o.bg }}; box-shadow: 0 4px 14px rgba(16,16,18,0.05);" style-active="transform: scale(0.985);">{{ o.label }}</button>
          </sc-for>
        </div>
        <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
          <div style="text-align: center; font-size: 18px; font-weight: 600; color: {{ brainFeedbackFg }}; letter-spacing: -0.3px; min-height: 24px;">{{ brainFeedback }}</div>
          <button onClick="{{ onBrainQuit }}" style="width: 100%; min-height: 56px; border: none; border-radius: 20px; background: #FFFFFF; color: #6E6E73; font-family: inherit; font-size: 17px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #EFEFF2;">Закончить</button>
          <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 2px auto 0;"></div>
        </div>
      </sc-if>

      <sc-if value="{{ brainDone }}" hint-placeholder-val="{{ false }}">
        <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 18px; display: flex; flex-direction: column; gap: 12px; justify-content: center;">
          <div style="padding: 28px 22px; border-radius: 30px; background: #FFFFFF; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 8px 26px rgba(16,16,18,0.06);">
            <div style="width: 54px; height: 54px; border-radius: 50%; font-size: 26px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; color: {{ brainResultFg }}; background: {{ brainResultBg }};">{{ brainResultMark }}</div>
            <div style="font-size: 44px; font-weight: 800; color: #101012; letter-spacing: -1.8px; line-height: 1;">{{ brainScore }}</div>
            <div style="font-size: 26px; font-weight: 700; color: #101012; letter-spacing: -0.7px; line-height: 1.15;">{{ brainResultTitle }}</div>
            <div style="font-size: 17px; font-weight: 500; color: #6E6E73; line-height: 1.4; letter-spacing: -0.2px;">{{ brainResultText }}</div>
          </div>
          <div style="padding: 18px 20px; border-radius: 22px; background: #FFFFFF; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 4px 14px rgba(16,16,18,0.05);">
            <div style="font-size: 13px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F;">СЛОВА БЫЛИ ТАКИЕ</div>
            <div style="font-size: 20px; font-weight: 600; color: #101012; letter-spacing: -0.3px; line-height: 1.4; overflow-wrap: anywhere;">{{ brainWordList }}</div>
          </div>
        </div>
        <div style="flex: none; padding: 14px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
          <button onClick="{{ onBrainStart }}" style="width: 100%; min-height: 72px; border: none; border-radius: 24px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 22px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; box-shadow: 0 10px 24px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">Ещё раз</button>
          <button onClick="{{ onBack }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #EFEFF2;">Назад к расписанию</button>
          <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 2px auto 0;"></div>
        </div>
      </sc-if>
    </sc-if>

    <sc-if value="{{ isList }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 14px; display: flex; flex-direction: column; gap: 3px;">
        <div style="font-size: 34px; font-weight: 800; color: #101012; letter-spacing: -1.2px; line-height: 1.05;">Мои лекарства</div>
        <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">Нажмите на лекарство, чтобы изменить</div>
      </div>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 18px 8px; display: flex; flex-direction: column; gap: 10px;">
        <sc-for list="{{ medRows }}" as="m" hint-placeholder-count="4">
          <button onClick="{{ m.onEdit }}" style="width: 100%; text-align: left; border: none; border-radius: 22px; background: #FFFFFF; padding: 16px 18px; cursor: pointer; display: flex; align-items: center; gap: 14px; font-family: inherit; box-shadow: 0 4px 14px rgba(16,16,18,0.05);" style-active="background: #EFEFF2;">
            <div style="flex: none; width: 76px; font-size: 26px; font-weight: 800; color: #101012; letter-spacing: -1px; font-variant-numeric: tabular-nums;">{{ m.time }}</div>
            <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px;">
              <div style="font-size: 20px; font-weight: 600; color: #101012; letter-spacing: -0.4px; overflow-wrap: anywhere; word-break: break-word;">{{ m.name }}</div>
              <div style="font-size: 16px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px; overflow-wrap: anywhere; word-break: break-word;">{{ m.dose }} · {{ m.note }}</div>
            </div>
            <div style="flex: none; font-size: 26px; color: #A5A5AA; font-weight: 400;">›</div>
          </button>
        </sc-for>

        <sc-if value="{{ medsEmpty }}" hint-placeholder-val="{{ false }}">
          <div style="padding: 26px 20px; border-radius: 22px; background: #FFFFFF; font-size: 19px; font-weight: 500; color: #6E6E73; line-height: 1.4; letter-spacing: -0.2px;">
            Список пуст. Нажмите «Добавить лекарство» внизу.
          </div>
        </sc-if>
      </div>

      <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
        <button onClick="{{ onAdd }}" style="width: 100%; min-height: 72px; border: none; border-radius: 24px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 22px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 10px 24px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">
          <span style="font-size: 28px; font-weight: 400;">＋</span> Добавить лекарство
        </button>
        <button onClick="{{ onBack }}" style="width: 100%; min-height: 62px; border: none; border-radius: 22px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Назад к расписанию</button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 4px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isEdit }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 12px;">
        <div style="font-size: 32px; font-weight: 800; color: #101012; letter-spacing: -1.1px; line-height: 1.05;">{{ editTitle }}</div>
      </div>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 0 18px 8px; display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">НАЗВАНИЕ</div>
          <input value="{{ draftName }}" onChange="{{ onDraftName }}" placeholder="Например, Лизиноприл" style="width: 100%; box-sizing: border-box; border: none; border-radius: 20px; background: #FFFFFF; padding: 18px 18px; font-size: 24px; font-weight: 600; color: #101012; letter-spacing: -0.4px; outline: none;" style-focus="box-shadow: 0 0 0 3px #0A84FF;" />
        </div>

        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">СКОЛЬКО ПРИНИМАТЬ</div>
          <input value="{{ draftDose }}" onChange="{{ onDraftDose }}" placeholder="Например, 1 таблетка, 10 мг" style="width: 100%; box-sizing: border-box; border: none; border-radius: 20px; background: #FFFFFF; padding: 18px 18px; font-size: 22px; font-weight: 500; color: #101012; letter-spacing: -0.3px; outline: none;" style-focus="box-shadow: 0 0 0 3px #0A84FF;" />
        </div>

        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">ВРЕМЯ ПРИЁМА</div>
          <div style="background: #FFFFFF; border-radius: 24px; padding: 16px 16px 18px; display: flex; flex-direction: column; gap: 12px;">
            <div style="text-align: center; font-size: 64px; font-weight: 800; color: #101012; letter-spacing: -3px; line-height: 1; font-variant-numeric: tabular-nums;">{{ draftTime }}</div>
            <div style="display: flex; gap: 12px;">
              <div style="flex: 1; display: flex; flex-direction: column; gap: 7px; align-items: center;">
                <div style="font-size: 15px; font-weight: 600; color: #6E6E73;">Часы</div>
                <div style="display: flex; gap: 8px; width: 100%;">
                  <button onClick="{{ onHourDown }}" style="flex: 1; min-height: 56px; border: none; border-radius: 18px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 28px; font-weight: 700; cursor: pointer;" style-active="background: #E4E4E9;">−</button>
                  <button onClick="{{ onHourUp }}" style="flex: 1; min-height: 56px; border: none; border-radius: 18px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 28px; font-weight: 700; cursor: pointer;" style-active="background: #E4E4E9;">+</button>
                </div>
              </div>
              <div style="flex: 1; display: flex; flex-direction: column; gap: 7px; align-items: center;">
                <div style="font-size: 15px; font-weight: 600; color: #6E6E73;">Минуты</div>
                <div style="display: flex; gap: 8px; width: 100%;">
                  <button onClick="{{ onMinDown }}" style="flex: 1; min-height: 56px; border: none; border-radius: 18px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 28px; font-weight: 700; cursor: pointer;" style-active="background: #E4E4E9;">−</button>
                  <button onClick="{{ onMinUp }}" style="flex: 1; min-height: 56px; border: none; border-radius: 18px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 28px; font-weight: 700; cursor: pointer;" style-active="background: #E4E4E9;">+</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">КОГДА</div>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <sc-for list="{{ noteOptions }}" as="n" hint-placeholder-count="4">
              <button onClick="{{ n.onPick }}" style="min-height: 56px; padding: 0 18px; border: none; border-radius: 18px; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.2px; cursor: pointer; color: {{ n.fg }}; background: {{ n.bg }};">{{ n.label }}</button>
            </sc-for>
          </div>
        </div>

        <sc-if value="{{ canDelete }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ onDelete }}" style="width: 100%; min-height: 62px; border: none; border-radius: 20px; background: #FDE7E5; color: #B3261E; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #F9D6D3;">Удалить лекарство</button>
        </sc-if>
      </div>

      <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px; background: #F2F2F7;">
        <button onClick="{{ onSave }}" style="width: 100%; min-height: 76px; border: none; border-radius: 24px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 24px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; box-shadow: 0 10px 24px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">Сохранить</button>
        <button onClick="{{ onCancel }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #EFEFF2;">Отмена</button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 4px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isContacts }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 14px; display: flex; flex-direction: column; gap: 3px;">
        <div style="font-size: 34px; font-weight: 800; color: #101012; letter-spacing: -1.2px; line-height: 1.05;">Близкие контакты</div>
        <div style="font-size: 17px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px;">Им позвонит кнопка «Мне нужна помощь» — по порядку</div>
      </div>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 18px 8px; display: flex; flex-direction: column; gap: 10px;">
        <sc-for list="{{ contactRows }}" as="c" hint-placeholder-count="2">
          <button onClick="{{ c.onEdit }}" style="width: 100%; text-align: left; border: none; border-radius: 22px; background: #FFFFFF; padding: 16px 18px; cursor: pointer; display: flex; align-items: center; gap: 14px; font-family: inherit; box-shadow: 0 4px 14px rgba(16,16,18,0.05);" style-active="background: #EFEFF2;">
            <div style="flex: none; width: 44px; height: 44px; border-radius: 50%; background: #E6F0FE; color: #0A4EA8; font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: center;">{{ c.order }}</div>
            <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px;">
              <div style="font-size: 20px; font-weight: 700; color: #101012; letter-spacing: -0.4px; overflow-wrap: anywhere; word-break: break-word;">{{ c.name }}</div>
              <div style="font-size: 17px; font-weight: 500; color: #101012; letter-spacing: -0.2px;">{{ c.phone }}</div>
              <div style="font-size: 16px; font-weight: 500; color: #6E6E73; letter-spacing: -0.2px; overflow-wrap: anywhere;">{{ c.role }}</div>
            </div>
            <div style="flex: none; font-size: 26px; color: #A5A5AA;">›</div>
          </button>
        </sc-for>

        <sc-if value="{{ contactsEmpty }}" hint-placeholder-val="{{ false }}">
          <div style="padding: 26px 20px; border-radius: 22px; background: #FFFFFF; font-size: 19px; font-weight: 500; color: #6E6E73; line-height: 1.4; letter-spacing: -0.2px;">
            Контактов пока нет. Экстренный вызов пойдёт сразу в скорую 103.
          </div>
        </sc-if>

        <div style="padding: 16px 20px; border-radius: 20px; background: #FFF3E0; color: #8A4B00; font-size: 16px; font-weight: 500; line-height: 1.4; letter-spacing: -0.2px;">
          Последним в цепочке всегда идёт скорая помощь, 103.
        </div>
      </div>

      <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px;">
        <button onClick="{{ onAddContact }}" style="width: 100%; min-height: 72px; border: none; border-radius: 24px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 22px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 10px 24px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">
          <span style="font-size: 28px; font-weight: 400;">＋</span> Добавить контакт
        </button>
        <button onClick="{{ onBack }}" style="width: 100%; min-height: 62px; border: none; border-radius: 22px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 6px 20px rgba(16,16,18,0.07);" style-active="background: #EFEFF2;">Назад к расписанию</button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 4px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isContactEdit }}" hint-placeholder-val="{{ false }}">
      <div style="flex: none; padding: 6px 22px 12px;">
        <div style="font-size: 32px; font-weight: 800; color: #101012; letter-spacing: -1.1px; line-height: 1.05;">{{ cTitle }}</div>
      </div>

      <div style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 0 18px 8px; display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">ИМЯ</div>
          <input value="{{ cName }}" onChange="{{ onCName }}" placeholder="Например, Андрей" style="width: 100%; box-sizing: border-box; border: none; border-radius: 20px; background: #FFFFFF; padding: 18px; font-size: 24px; font-weight: 600; color: #101012; letter-spacing: -0.4px; outline: none;" style-focus="box-shadow: 0 0 0 3px #0A84FF;" />
        </div>

        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">НОМЕР ТЕЛЕФОНА</div>
          <input value="{{ cPhone }}" onChange="{{ onCPhone }}" type="tel" placeholder="+7 900 000-00-00" style="width: 100%; box-sizing: border-box; border: none; border-radius: 20px; background: #FFFFFF; padding: 18px; font-size: 24px; font-weight: 600; color: #101012; letter-spacing: -0.2px; outline: none; font-variant-numeric: tabular-nums;" style-focus="box-shadow: 0 0 0 3px #0A84FF;" />
        </div>

        <div style="display: flex; flex-direction: column; gap: 7px;">
          <div style="font-size: 14px; font-weight: 700; letter-spacing: 1.2px; color: #5A5A5F; padding-left: 4px;">ПРИМЕЧАНИЕ</div>
          <input value="{{ cRole }}" onChange="{{ onCRole }}" placeholder="Кем приходится, когда звонить" style="width: 100%; box-sizing: border-box; border: none; border-radius: 20px; background: #FFFFFF; padding: 18px; font-size: 20px; font-weight: 500; color: #101012; letter-spacing: -0.3px; outline: none;" style-focus="box-shadow: 0 0 0 3px #0A84FF;" />
        </div>

        <sc-if value="{{ cCanDelete }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ onCDelete }}" style="width: 100%; min-height: 62px; border: none; border-radius: 20px; background: #FDE7E5; color: #B3261E; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #F9D6D3;">Удалить контакт</button>
        </sc-if>
      </div>

      <div style="flex: none; padding: 10px 18px 22px; display: flex; flex-direction: column; gap: 10px; background: #F2F2F7;">
        <button onClick="{{ onCSave }}" style="width: 100%; min-height: 76px; border: none; border-radius: 24px; background: #0A84FF; color: #FFFFFF; font-family: inherit; font-size: 24px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer; box-shadow: 0 10px 24px rgba(10,132,255,0.3);" style-active="transform: scale(0.985);">Сохранить</button>
        <button onClick="{{ onCCancel }}" style="width: 100%; min-height: 58px; border: none; border-radius: 20px; background: #FFFFFF; color: #101012; font-family: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: #EFEFF2;">Отмена</button>
        <div style="width: 132px; height: 5px; border-radius: 3px; background: #101012; opacity: 0.85; margin: 4px auto 0;"></div>
      </div>
    </sc-if>

    <sc-if value="{{ isSos }}" hint-placeholder-val="{{ false }}">
      <div style="position: absolute; inset: 0; background: #E5322A; display: flex; flex-direction: column; padding: 60px 24px 26px;">
        <div style="flex: none; display: flex; align-items: center; gap: 10px;">
          <span style="width: 13px; height: 13px; border-radius: 50%; background: #FFFFFF; display: inline-block; animation: scDot 1.2s ease-in-out infinite;"></span>
          <span style="font-size: 14px; font-weight: 700; letter-spacing: 1.4px; color: #FFE3E1;">ЭКСТРЕННЫЙ ВЫЗОВ</span>
        </div>

        <div style="flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 10px;">
          <div style="font-size: 22px; font-weight: 600; color: #FFD9D6; letter-spacing: -0.3px;">{{ sosAction }}</div>
          <div style="font-size: 46px; font-weight: 800; color: #FFFFFF; line-height: 1.08; letter-spacing: -1.6px; overflow-wrap: anywhere; word-break: break-word;">{{ sosName }}</div>
          <div style="font-size: 20px; font-weight: 500; color: #FFD9D6; letter-spacing: -0.2px;">{{ sosRole }} · {{ sosPhone }}</div>
          <div style="font-size: 19px; font-weight: 500; color: #FFFFFF; opacity: 0.92; letter-spacing: -0.2px; margin-top: 14px;">{{ sosHint }}</div>
        </div>

        <div style="flex: none; display: flex; flex-direction: column; gap: 12px;">
          <sc-if value="{{ sosCanNext }}" hint-placeholder-val="{{ true }}">
            <button onClick="{{ onSosNext }}" style="width: 100%; min-height: 66px; border: 2px solid rgba(255,255,255,0.55); border-radius: 22px; background: transparent; color: #FFFFFF; font-family: inherit; font-size: 19px; font-weight: 600; letter-spacing: -0.3px; cursor: pointer;" style-active="background: rgba(255,255,255,0.14);">{{ sosNextLabel }}</button>
          </sc-if>
          <button onClick="{{ onSosCancel }}" style="width: 100%; min-height: 84px; border: none; border-radius: 26px; background: #FFFFFF; color: #B3261E; font-family: inherit; font-size: 25px; font-weight: 700; letter-spacing: -0.4px; cursor: pointer;" style-active="background: #F4F4F6;">Отменить вызов</button>
          <div style="width: 132px; height: 5px; border-radius: 3px; background: #FFFFFF; opacity: 0.8; margin: 2px auto 0;"></div>
        </div>
      </div>
    </sc-if>
  </div>

  <div style="width: 390px; display: flex; flex-direction: column; gap: 10px; padding: 16px 18px; border-radius: 24px; background: #FFFFFF; box-shadow: 0 8px 24px rgba(16,16,18,0.07);">
    <div style="font-size: 12px; font-weight: 700; letter-spacing: 1.4px; color: #5A5A5F;">ДЕМО-УПРАВЛЕНИЕ</div>
    <div style="display: flex; gap: 8px;">
      <button onClick="{{ onJump }}" style="flex: 1; min-height: 44px; border: none; border-radius: 14px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 15px; font-weight: 600; letter-spacing: -0.2px; cursor: pointer;">К следующему приёму</button>
      <button onClick="{{ onReset }}" style="flex: 1; min-height: 44px; border: none; border-radius: 14px; background: #F2F2F7; color: #101012; font-family: inherit; font-size: 15px; font-weight: 600; letter-spacing: -0.2px; cursor: pointer;">Сбросить день</button>
    </div>
    <div style="font-size: 13px; color: #5A5A5F; line-height: 1.4; letter-spacing: -0.1px;">Время ускорено. Список лекарств сохраняется на устройстве.</div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:440,&quot;height&quot;:1080},&quot;demoSpeed&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:20,&quot;min&quot;:1,&quot;max&quot;:120,&quot;step&quot;:1,&quot;unit&quot;:&quot;×&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Поведение&quot;},&quot;caregiver&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;Анне&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Контакт&quot;}}">#const DEFAULT_MEDS = [
{ id: 1, t: 9 * 60, name: 'Лизиноприл', dose: '1 таблетка, 10 мг', note: 'После еды' },
  { id: 2, t: 13 * 60, name: 'Метформин', dose: '1 таблетка, 500 мг', note: 'Во время еды' },
  { id: 3, t: 19 * 60, name: 'Аторвастатин', dose: '1 таблетка, 20 мг', note: 'После еды' },
  { id: 4, t: 21 * 60 + 30, name: 'Витамин D', dose: '1 капля', note: 'Перед сном' }
];
const NOTES = ['До еды', 'Во время еды', 'После еды', 'Натощак', 'Перед сном'];
const STORE = 'silvercare.meds.v1';
const BRAIN_STORE = 'silvercare.brain.v1';
const BRAIN_WORDS = ['Яблоко', 'Ключи', 'Лампа', 'Река', 'Письмо', 'Чайник', 'Зонт', 'Сосед', 'Часы', 'Кресло', 'Груша', 'Поезд', 'Окно', 'Книга', 'Мёд', 'Ложка', 'Сад', 'Лестница'];
const BRAIN_SHOW_SEC = 8;

class Component extends DCLogic {
  state = {
    sec: 8 * 3600 + 59 * 60 + 40,
    meds: DEFAULT_MEDS,
    taken: {}, snooze: {}, spoken: null,
    view: 'today',
    draft: null,
    sos: null,
    contacts: [
      { id: 1, name: 'Анна', role: 'Дочь', phone: '+7 916 204-18-03' },
      { id: 2, name: 'Пётр Ильич', role: 'Сосед из 42 кв.', phone: '+7 916 771-09-55' }
    ],
    cDraft: null,
    brain: null,
    brainStats: { streak: 0, last: null, plays: 0 }
  };

  startBrain() {
    const pool = [...BRAIN_WORDS].sort(() => Math.random() - 0.5);
    const targets = pool.slice(0, 4);
    const rest = pool.slice(4);
    const qs = targets.slice(0, 3).map((t, i) => ({
      answer: t,
      options: [t, ...rest.slice(i * 3, i * 3 + 3)].sort(() => Math.random() - 0.5)
    }));
    clearInterval(this.brainTimer);
    this.setState({ view: 'brainPlay', brain: { phase: 'show', left: BRAIN_SHOW_SEC, targets, qs, qi: 0, correct: 0, picked: null, wasRight: false } });
    this.brainTimer = setInterval(() => {
      const b = this.state.brain;
      if (!b || b.phase !== 'show') { clearInterval(this.brainTimer); return; }
      if (b.left > 1) this.setState({ brain: { ...b, left: b.left - 1 } });
      else { clearInterval(this.brainTimer); this.setState({ brain: { ...b, left: 0, phase: 'ask' } }); }
    }, 1000);
  }

  brainReady() {
    clearInterval(this.brainTimer);
    const b = this.state.brain;
    if (b) this.setState({ brain: { ...b, phase: 'ask', left: 0 } });
  }

  brainPick(word) {
    const b = this.state.brain;
    if (!b || b.phase !== 'ask' || b.picked) return;
    const right = word === b.qs[b.qi].answer;
    this.setState({ brain: { ...b, picked: word, wasRight: right, correct: b.correct + (right ? 1 : 0) } });
    clearTimeout(this.brainNextTimer);
    this.brainNextTimer = setTimeout(() => {
      const cur = this.state.brain;
      if (!cur) return;
      if (cur.qi >= cur.qs.length - 1) this.finishBrain(cur);
      else this.setState({ brain: { ...cur, qi: cur.qi + 1, picked: null, wasRight: false } });
    }, 1100);
  }

  finishBrain(b) {
    const perfect = b.correct === b.qs.length;
    const stats = {
      streak: perfect ? (this.state.brainStats.streak || 0) + 1 : 0,
      last: `${b.correct} из ${b.qs.length}`,
      plays: (this.state.brainStats.plays || 0) + 1
    };
    try { localStorage.setItem(BRAIN_STORE, JSON.stringify(stats)); } catch (e) {}
    this.setState({ brainStats: stats, brain: { ...b, phase: 'done', picked: null } });
  }

  sosChain() {
    return [...this.state.contacts, { id: 0, name: 'Скорая помощь', role: 'Единая служба', phone: '103' }];
  }
  persistContacts(list) { try { localStorage.setItem('silvercare.contacts.v1', JSON.stringify(list)); } catch (e) {} }
  setCDraft(patch) { this.setState(s => ({ cDraft: { ...s.cDraft, ...patch } })); }
  startSos() {
    this.setState({ sos: { stage: 0, left: 20 } });
    clearInterval(this.sosTimer);
    this.sosTimer = setInterval(() => this.tickSos(), 1000);
  }
  tickSos() {
    const s = this.state.sos;
    if (!s) { clearInterval(this.sosTimer); return; }
    if (s.left > 1) { this.setState({ sos: { ...s, left: s.left - 1 } }); return; }
    this.nextSos();
  }
  nextSos() {
    const s = this.state.sos;
    if (!s) return;
    const chain = this.sosChain();
    if (s.stage >= chain.length - 1) { this.setState({ sos: { ...s, left: 0 } }); clearInterval(this.sosTimer); return; }
    this.setState({ sos: { stage: s.stage + 1, left: 20 } });
  }
  endSos() {
    clearInterval(this.sosTimer);
    this.setState({ sos: null });
  }

  componentDidMount() {
    try {
      const raw = localStorage.getItem(STORE);
      if (raw) { const m = JSON.parse(raw); if (Array.isArray(m)) this.setState({ meds: m }); }
      const rawC = localStorage.getItem('silvercare.contacts.v1');
      if (rawC) { const c = JSON.parse(rawC); if (Array.isArray(c)) this.setState({ contacts: c }); }
      const rawB = localStorage.getItem(BRAIN_STORE);
      if (rawB) { const b = JSON.parse(rawB); if (b && typeof b === 'object') this.setState({ brainStats: { streak: b.streak || 0, last: b.last || null, plays: b.plays || 0 } }); }
    } catch (e) {}
    this.timer = setInterval(() => {
      const mult = this.props.demoSpeed ?? 20;
      this.setState(s => ({ sec: (s.sec + mult * 0.25) % 86400 }));
    }, 250);
  }
  componentWillUnmount() { clearInterval(this.timer); clearInterval(this.sosTimer); clearInterval(this.brainTimer); clearTimeout(this.brainNextTimer); }

  persist(meds) { try { localStorage.setItem(STORE, JSON.stringify(meds)); } catch (e) {} }
  sorted() { return [...this.state.meds].sort((a, b) => a.t - b.t); }


  due() {
    const now = this.state.sec / 60;
    return this.sorted().find(d => {
      if (this.state.taken[d.id]) return false;
      const t = d.t + (this.state.snooze[d.id] || 0);
      return now >= t && now < t + 90;
    }) || null;
  }
  next() {
    const now = this.state.sec / 60;
    return this.sorted().find(d => !this.state.taken[d.id] && d.t + (this.state.snooze[d.id] || 0) > now) || null;
  }
  fmt(min) {
    const m = Math.floor(((min % 1440) + 1440) % 1440);
    return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
  }
  setDraft(patch) { this.setState(s => ({ draft: { ...s.draft, ...patch } })); }

  renderVals() {
    const now = this.state.sec / 60;
    const meds = this.sorted();
    const due = this.due();
    const next = this.next();
    const caregiver = this.props.caregiver ?? 'Анне';
    const draft = this.state.draft || { name: '', dose: '', t: 9 * 60, note: 'После еды', id: null };

    const doses = meds.map(d => {
      const t = d.t + (this.state.snooze[d.id] || 0);
      let status = 'Позже', fg = '#6E6E73', bg = '#F2F2F7';
      if (this.state.taken[d.id]) { status = 'Принято'; fg = '#1B7A3E'; bg = '#E4F5E9'; }
      else if (due && due.id === d.id) { status = 'Сейчас'; fg = '#FFFFFF'; bg = '#FF3B30'; }
      else if (now > t + 90) { status = 'Пропущено'; fg = '#B3261E'; bg = '#FDE7E5'; }
      return { time: this.fmt(t), name: d.name, dose: d.dose, status, fg, bg };
    });

    const medRows = meds.map(m => ({
      time: this.fmt(m.t), name: m.name, dose: m.dose, note: m.note,
      onEdit: () => this.setState({ view: 'edit', draft: { ...m } })
    }));

    const noteOptions = NOTES.map(label => ({
      label,
      fg: draft.note === label ? '#FFFFFF' : '#101012',
      bg: draft.note === label ? '#0A84FF' : '#FFFFFF',
      onPick: () => this.setDraft({ note: label })
    }));

    let countdownText = '';
    if (next) {
      const left = Math.max(0, Math.round(next.t + (this.state.snooze[next.id] || 0) - now));
      countdownText = left >= 60 ? `через ${Math.floor(left / 60)} ч ${left % 60} мин` : `через ${left} мин`;
    }

    const cD = this.state.cDraft || { id: null, name: '', phone: '', role: '' };
    const contactRows = this.state.contacts.map((c, i) => ({
      name: c.name, phone: c.phone, role: c.role || '—', order: `${i + 1}-й`,
      onEdit: () => this.setState({ view: 'contactEdit', cDraft: { ...c } })
    }));

    const sos = this.state.sos;
    const chain = this.sosChain();
    const sosC = sos ? chain[sos.stage] : chain[0];
    const sosLast = sos ? sos.stage >= chain.length - 1 : false;
    let sosHint = '';
    if (sos) {
      if (sosLast) sosHint = sos.left > 0 ? 'Идёт соединение со скорой помощью. Не кладите телефон.' : 'Соединение установлено. Говорите спокойно.';
      else sosHint = `Если не ответит за ${sos.left} сек., позвоню следующему: ${chain[sos.stage + 1].name}.`;
    }

    const b = this.state.brain;
    const bs = this.state.brainStats;
    const q = b && b.qs ? b.qs[b.qi] : null;
    const brainOptions = q ? q.options.map(label => {
      let bg = '#FFFFFF', fg = '#101012';
      if (b.picked) {
        if (label === q.answer) { bg = '#1B7A3E'; fg = '#FFFFFF'; }
        else if (label === b.picked) { bg = '#FDE7E5'; fg = '#B3261E'; }
      }
      return { label, bg, fg, onPick: () => this.brainPick(label) };
    }) : [];
    const perfect = b ? b.correct === b.qs.length : false;

    return {
      clockText: this.fmt(now),
      isBrain: this.state.view === 'brain',
      isBrainPlay: this.state.view === 'brainPlay',
      brainShowing: !!b && b.phase === 'show',
      brainAsking: !!b && b.phase === 'ask',
      brainDone: !!b && b.phase === 'done',
      brainStreak: bs.streak || 0,
      brainLast: bs.last || '—',
      brainBadge: bs.streak ? `${bs.streak} дн.` : 'Новое',
      brainBadgeFg: bs.streak ? '#1B7A3E' : '#0A4EA8',
      brainBadgeBg: bs.streak ? '#E4F5E9' : '#E6F0FE',
      brainWords: b ? b.targets.map(label => ({ label })) : [],
      brainWordList: b ? b.targets.join(' · ') : '',
      brainCountdown: b ? `Осталось ${b.left} сек.` : '',
      brainProgress: b ? `${Math.round((b.left / BRAIN_SHOW_SEC) * 100)}%` : '0%',
      brainStepLabel: b ? (b.phase === 'show' ? 'ШАГ 1 ИЗ 2' : b.phase === 'ask' ? `ВОПРОС ${b.qi + 1} ИЗ ${b.qs.length}` : 'ГОТОВО') : '',
      brainTitle: b ? (b.phase === 'show' ? 'Запомните эти слова' : b.phase === 'ask' ? 'Какое слово вы видели?' : 'Упражнение окончено') : '',
      brainOptions,
      brainFeedback: b && b.picked ? (b.wasRight ? 'Верно' : `Было слово «${q.answer}»`) : '',
      brainFeedbackFg: b && b.wasRight ? '#1B7A3E' : '#B3261E',
      brainScore: b ? `${b.correct} из ${b.qs.length}` : '',
      brainResultMark: perfect ? '✓' : '•',
      brainResultFg: perfect ? '#1B7A3E' : '#0A4EA8',
      brainResultBg: perfect ? '#E4F5E9' : '#E6F0FE',
      brainResultTitle: perfect ? 'Всё верно' : 'Хорошая работа',
      brainResultText: perfect
        ? `Серия — ${bs.streak} дн. Возвращайтесь завтра, память любит постоянство.`
        : 'Память тренируется повторением. Попробуйте ещё раз — станет легче.',
      onOpenBrain: () => this.setState({ view: 'brain', brain: null }),
      onBrainStart: () => this.startBrain(),
      onBrainReady: () => this.brainReady(),
      onBrainQuit: () => { clearInterval(this.brainTimer); clearTimeout(this.brainNextTimer); this.setState({ view: 'brain', brain: null }); },
      isSos: !!sos,
      sosAction: sos ? (sos.left > 0 || !sosLast ? 'Звоню' : 'На линии') : '',
      sosName: sosC.name,
      sosRole: sosC.role,
      sosPhone: sosC.phone,
      sosHint,
      sosCanNext: !!sos && !sosLast,
      sosNextLabel: sos && !sosLast ? `Сразу позвонить: ${chain[sos.stage + 1].name}` : '',
      isContacts: this.state.view === 'contacts',
      isContactEdit: this.state.view === 'contactEdit',
      contactRows,
      contactsEmpty: this.state.contacts.length === 0,
      cTitle: cD.id ? 'Изменить контакт' : 'Новый контакт',
      cName: cD.name, cPhone: cD.phone, cRole: cD.role,
      cCanDelete: !!cD.id,
      onOpenContacts: () => this.setState({ view: 'contacts' }),
      onAddContact: () => this.setState({ view: 'contactEdit', cDraft: { id: null, name: '', phone: '', role: '' } }),
      onCName: e => this.setCDraft({ name: e.target.value }),
      onCPhone: e => this.setCDraft({ phone: e.target.value }),
      onCRole: e => this.setCDraft({ role: e.target.value }),
      onCSave: () => {
        const d = this.state.cDraft;
        if (!d || !d.name.trim()) { this.setState({ view: 'contacts', cDraft: null }); return; }
        const rec = { id: d.id || Date.now(), name: d.name.trim(), phone: d.phone.trim(), role: d.role.trim() };
        const list = d.id ? this.state.contacts.map(c => (c.id === d.id ? rec : c)) : [...this.state.contacts, rec];
        this.persistContacts(list);
        this.setState({ contacts: list, view: 'contacts', cDraft: null });
      },
      onCDelete: () => {
        const d = this.state.cDraft;
        const list = this.state.contacts.filter(c => c.id !== (d && d.id));
        this.persistContacts(list);
        this.setState({ contacts: list, view: 'contacts', cDraft: null });
      },
      onCCancel: () => this.setState({ view: 'contacts', cDraft: null }),
      onSos: () => this.startSos(),
      onSosNext: () => this.nextSos(),
      onSosCancel: () => this.endSos(),
      dateText: 'среда, 19 сентября',
      takenCount: Object.keys(this.state.taken).length,
      totalCount: meds.length,
      caregiver,
      isToday: this.state.view === 'today',
      isList: this.state.view === 'list',
      isEdit: this.state.view === 'edit',
      isDue: !!due,
      isWaiting: !due && !!next,
      isDone: !due && !next,
      doneTitle: meds.length ? 'Все лекарства на сегодня приняты' : 'Лекарства ещё не добавлены',
      doneSubtitle: meds.length ? `${caregiver} отправлено уведомление` : 'Откройте «Мои лекарства» и добавьте первое',
      dueName: due ? due.name : '',
      dueDose: due ? due.dose : '',
      dueNote: due ? due.note : '',
      dueTime: due ? this.fmt(due.t + (this.state.snooze[due.id] || 0)) : '',
      nextTime: next ? this.fmt(next.t + (this.state.snooze[next.id] || 0)) : '',
      nextName: next ? next.name : '',
      nextDose: next ? next.dose : '',
      countdownText,
      doses, medRows, noteOptions,
      medsEmpty: meds.length === 0,
      editTitle: draft.id ? 'Изменить лекарство' : 'Новое лекарство',
      draftName: draft.name,
      draftDose: draft.dose,
      draftTime: this.fmt(draft.t),
      canDelete: !!draft.id,

      onOpenList: () => this.setState({ view: 'list' }),
      onBack: () => this.setState({ view: 'today' }),
      onAdd: () => this.setState({ view: 'edit', draft: { id: null, name: '', dose: '', t: 9 * 60, note: 'После еды' } }),
      onDraftName: e => this.setDraft({ name: e.target.value }),
      onDraftDose: e => this.setDraft({ dose: e.target.value }),
      onHourUp: () => this.setDraft({ t: (draft.t + 60) % 1440 }),
      onHourDown: () => this.setDraft({ t: (draft.t + 1380) % 1440 }),
      onMinUp: () => this.setDraft({ t: (draft.t + 5) % 1440 }),
      onMinDown: () => this.setDraft({ t: (draft.t + 1435) % 1440 }),
      onSave: () => {
        const d = this.state.draft;
        if (!d || !d.name.trim()) { this.setState({ view: 'list', draft: null }); return; }
        const rec = { id: d.id || Date.now(), name: d.name.trim(), dose: d.dose.trim() || '1 таблетка', t: d.t, note: d.note };
        const meds2 = d.id ? this.state.meds.map(m => (m.id === d.id ? rec : m)) : [...this.state.meds, rec];
        this.persist(meds2);
        this.setState({ meds: meds2, view: 'list', draft: null });
      },
      onDelete: () => {
        const d = this.state.draft;
        const meds2 = this.state.meds.filter(m => m.id !== (d && d.id));
        this.persist(meds2);
        this.setState({ meds: meds2, view: 'list', draft: null });
      },
      onCancel: () => this.setState({ view: 'list', draft: null }),

      onTake: () => {
        if (!due) return;
        this.setState(s => ({ taken: { ...s.taken, [due.id]: true }, spoken: null }));
      },
      onSnooze: () => {
        if (!due) return;
        this.setState(s => ({ snooze: { ...s.snooze, [due.id]: (s.snooze[due.id] || 0) + 15 }, spoken: null }));
      },
      onJump: () => { if (next) this.setState({ sec: (next.t + (this.state.snooze[next.id] || 0)) * 60 - 5, view: 'today' }); },
      onReset: () => this.setState({ sec: 8 * 3600 + 59 * 60 + 40, taken: {}, snooze: {}, spoken: null, view: 'today' })
    };
  }*
}
</script>
</body>
</html>
